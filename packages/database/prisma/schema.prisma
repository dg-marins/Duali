generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model Usuario {
 id String @id @default(uuid()) @db.Uuid
 nome String @db.VarChar(180)
 email String @unique @db.VarChar(180)
 senhaHash String
 ultimoLoginEm DateTime?
 sessoes Sessao[]
 auditorias Auditoria[]
 ativo Boolean @default(true)
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
}
model Pessoa {
 id String @id @default(uuid()) @db.Uuid
 nomeCompleto String @db.VarChar(180)
 nomeSocial String? @db.VarChar(180)
 cpf String? @unique @db.VarChar(11)
 rg String? @db.VarChar(30)
 dataNascimento DateTime? @db.Date
 email String? @db.VarChar(180)
 telefone String? @db.VarChar(30)
 endereco String?
 observacoes String?
 ativa Boolean @default(true)
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
 vinculos Vinculo[]
}
model Unidade {
 id String @id @default(uuid()) @db.Uuid
 nome String
 sigla String @unique
 cidade String?
 uf String @db.VarChar(2)
 ativa Boolean @default(true)
 diasAlerta Int @default(30)
 vinculos Vinculo[]
}
model Equipe {
 historico VinculoEquipeHistorico[]
 id String @id @default(uuid()) @db.Uuid
 nome String @unique
 ativa Boolean @default(true)
 observacoes String?
 vinculos Vinculo[]
}
enum TipoVinculo {
 CLT
 ESTAGIO
}
enum StatusVinculo {
 ATIVO
 AFASTADO
 DESLIGADO
}
model Vinculo {
 estagio Estagio?
 documentos DocumentoVinculo[]
 seguros SeguroEstagio[]
 equipesHistorico VinculoEquipeHistorico[]
 id String @id @default(uuid()) @db.Uuid
 pessoaId String @db.Uuid
 pessoa Pessoa @relation(fields:[pessoaId],references:[id])
 unidadeId String @db.Uuid
 unidade Unidade @relation(fields:[unidadeId],references:[id])
 equipeId String? @db.Uuid
 equipe Equipe? @relation(fields:[equipeId],references:[id])
 tipo TipoVinculo
 status StatusVinculo @default(ATIVO)
 matricula String?
 dataAdmissao DateTime @db.Date
 dataDesligamento DateTime? @db.Date
 cargoFuncao String?
 gestor String?
 observacoes String?
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
 @@index([pessoaId])
 @@index([unidadeId,status])
 @@index([equipeId])
}

model Sessao {
 tokenHash String @id
 csrf String
 usuarioId String @db.Uuid
 usuario Usuario @relation(fields:[usuarioId],references:[id])
 expiraEm DateTime
 criadoEm DateTime @default(now())
 @@index([usuarioId])
 @@index([expiraEm])
}
model Auditoria {
 id String @id @default(uuid()) @db.Uuid
 usuarioId String? @db.Uuid
 usuario Usuario? @relation(fields:[usuarioId],references:[id])
 acao String
 entidade String
 entidadeId String?
 dadosAnteriores Json?
 dadosNovos Json?
 criadoEm DateTime @default(now())
 @@index([entidade,entidadeId])
 @@index([criadoEm])
}
model VinculoEquipeHistorico {
 id String @id @default(uuid()) @db.Uuid
 vinculoId String @db.Uuid
 vinculo Vinculo @relation(fields:[vinculoId],references:[id])
 equipeId String @db.Uuid
 equipe Equipe @relation(fields:[equipeId],references:[id])
 inicioEm DateTime
 fimEm DateTime?
 @@index([vinculoId,inicioEm])
}
model InstituicaoEnsino {
 id String @id @default(uuid()) @db.Uuid
 nome String
 sigla String?
 ativa Boolean @default(true)
 observacoes String?
 estagios Estagio[]
}
model Estagio {
 id String @id @default(uuid()) @db.Uuid
 vinculoId String @unique @db.Uuid
 vinculo Vinculo @relation(fields:[vinculoId],references:[id])
 instituicaoEnsinoId String? @db.Uuid
 instituicaoEnsino InstituicaoEnsino? @relation(fields:[instituicaoEnsinoId],references:[id])
 matriculaAcademica String?
 curso String?
 periodoAcademico String?
 valorBolsa Decimal? @db.Decimal(12,2)
 observacoes String?
}
model DocumentoVinculo {
 id String @id @default(uuid()) @db.Uuid
 vinculoId String @db.Uuid
 vinculo Vinculo @relation(fields:[vinculoId],references:[id])
 tipo String
 numero String?
 inicioVigencia DateTime? @db.Date
 fimVigencia DateTime? @db.Date
 status String @default("PENDENTE")
 observacoes String?
 @@index([vinculoId,fimVigencia])
}
model SeguroEstagio {
 id String @id @default(uuid()) @db.Uuid
 vinculoId String @db.Uuid
 vinculo Vinculo @relation(fields:[vinculoId],references:[id])
 seguradora String
 numeroApolice String?
 inicioVigencia DateTime? @db.Date
 fimVigencia DateTime? @db.Date
 status String @default("PENDENTE")
 observacoes String?
 movimentacoes SeguroMovimentacao[]
 @@index([vinculoId,fimVigencia])
}
model SeguroMovimentacao {
 id String @id @default(uuid()) @db.Uuid
 seguroEstagioId String @db.Uuid
 seguroEstagio SeguroEstagio @relation(fields:[seguroEstagioId],references:[id])
 tipo String
 dataMovimentacao DateTime @db.Date
 observacoes String?
 @@index([seguroEstagioId,dataMovimentacao])
}
