generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model Usuario {
 ajustesBeneficios BeneficioAjuste[]
 ajustes DescansoAjuste[]
 consumos DescansoConsumo[]
 id String @id @default(uuid()) @db.Uuid
 nome String @db.VarChar(180)
 email String @unique @db.VarChar(180)
 senhaHash String
 ultimoLoginEm DateTime?
 sessoes Sessao[]
 auditorias Auditoria[]
 ativo Boolean @default(true)
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
}
model Pessoa {
 id String @id @default(uuid()) @db.Uuid
 nomeCompleto String @db.VarChar(180)
 nomeSocial String? @db.VarChar(180)
 cpf String? @unique @db.VarChar(11)
 rg String? @db.VarChar(30)
 dataNascimento DateTime? @db.Date
 email String? @db.VarChar(180)
 telefone String? @db.VarChar(30)
 endereco String?
 observacoes String?
 ativa Boolean @default(true)
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
 vinculos Vinculo[]
}
model Unidade {
 configuracoesBeneficios ConfiguracaoBeneficio[]
 id String @id @default(uuid()) @db.Uuid
 nome String
 sigla String @unique
 cidade String?
 uf String @db.VarChar(2)
 ativa Boolean @default(true)
 diasAlerta Int @default(30)
 vinculos Vinculo[]
}
model Equipe {
 historico VinculoEquipeHistorico[]
 id String @id @default(uuid()) @db.Uuid
 nome String @unique
 ativa Boolean @default(true)
 observacoes String?
 vinculos Vinculo[]
}
enum TipoVinculo {
 CLT
 ESTAGIO
}
enum StatusVinculo {
 ATIVO
 AFASTADO
 DESLIGADO
}
model Vinculo {
 beneficios BeneficioVinculo[]
 direitos DescansoDireito[]
 periodos DescansoPeriodo[]
 ajustes DescansoAjuste[]
 estagio Estagio?
 documentos DocumentoVinculo[]
 seguros SeguroEstagio[]
 equipesHistorico VinculoEquipeHistorico[]
 id String @id @default(uuid()) @db.Uuid
 pessoaId String @db.Uuid
 pessoa Pessoa @relation(fields:[pessoaId],references:[id])
 unidadeId String @db.Uuid
 unidade Unidade @relation(fields:[unidadeId],references:[id])
 equipeId String? @db.Uuid
 equipe Equipe? @relation(fields:[equipeId],references:[id])
 tipo TipoVinculo
 status StatusVinculo @default(ATIVO)
 matricula String?
 dataAdmissao DateTime @db.Date
 dataDesligamento DateTime? @db.Date
 cargoFuncao String?
 gestor String?
 observacoes String?
 criadoEm DateTime @default(now())
 atualizadoEm DateTime @updatedAt
 @@index([pessoaId])
 @@index([unidadeId,status])
 @@index([equipeId])
}

model Sessao {
 tokenHash String @id
 csrf String
 usuarioId String @db.Uuid
 usuario Usuario @relation(fields:[usuarioId],references:[id])
 expiraEm DateTime
 criadoEm DateTime @default(now())
 @@index([usuarioId])
 @@index([expiraEm])
}
model Auditoria {
 id String @id @default(uuid()) @db.Uuid
 usuarioId String? @db.Uuid
 usuario Usuario? @relation(fields:[usuarioId],references:[id])
 acao String
 entidade String
 entidadeId String?
 dadosAnteriores Json?
 dadosNovos Json?
 criadoEm DateTime @default(now())
 @@index([entidade,entidadeId])
 @@index([criadoEm])
}
model VinculoEquipeHistorico {
 id String @id @default(uuid()) @db.Uuid
 vinculoId String @db.Uuid
 vinculo Vinculo @relation(fields:[vinculoId],references:[id])
 equipeId String @db.Uuid
 equipe Equipe @relation(fields:[equipeId],references:[id])
 inicioEm DateTime
 fimEm DateTime?
 @@index([vinculoId,inicioEm])
}
model InstituicaoEnsino {
 id String @id @default(uuid()) @db.Uuid
 nome String
 sigla String?
 ativa Boolean @default(true)
 observacoes String?
 estagios Estagio[]
}
model Estagio {
 id String @id @default(uuid()) @db.Uuid
 vinculoId String @unique @db.Uuid
 vinculo Vinculo @relation(fields:[vinculoId],references:[id])
 instituicaoEnsinoId String? @db.Uuid
 instituicaoEnsino InstituicaoEnsino? @relation(fields:[instituicaoEnsinoId],references:[id])
 matriculaAcademica String?
 curso String?
 periodoAcademico String?
 valorBolsa Decimal? @db.Decimal(12,2)
 observacoes String?
}
model DocumentoVinculo {
 id String @id @default(uuid()) @db.Uuid
 vinculoId String @db.Uuid
 vinculo Vinculo @relation(fields:[vinculoId],references:[id])
 tipo String
 numero String?
 inicioVigencia DateTime? @db.Date
 fimVigencia DateTime? @db.Date
 status String @default("PENDENTE")
 observacoes String?
 @@index([vinculoId,fimVigencia])
}
model SeguroEstagio {
 id String @id @default(uuid()) @db.Uuid
 vinculoId String @db.Uuid
 vinculo Vinculo @relation(fields:[vinculoId],references:[id])
 seguradora String
 numeroApolice String?
 inicioVigencia DateTime? @db.Date
 fimVigencia DateTime? @db.Date
 status String @default("PENDENTE")
 observacoes String?
 movimentacoes SeguroMovimentacao[]
 @@index([vinculoId,fimVigencia])
}
model SeguroMovimentacao {
 id String @id @default(uuid()) @db.Uuid
 seguroEstagioId String @db.Uuid
 seguroEstagio SeguroEstagio @relation(fields:[seguroEstagioId],references:[id])
 tipo String
 dataMovimentacao DateTime @db.Date
 observacoes String?
 @@index([seguroEstagioId,dataMovimentacao])
}
model DescansoDireito {
 id String @id @default(uuid()) @db.Uuid
 vinculoId String @db.Uuid
 vinculo Vinculo @relation(fields:[vinculoId],references:[id])
 dataAquisicao DateTime @db.Date
 inicioAquisitivo DateTime? @db.Date
 fimAquisitivo DateTime? @db.Date
 quantidadeDias Decimal @db.Decimal(5,2)
 origem String @default("AUTOMATICA")
 prazoConcessivo DateTime? @db.Date
 observacoes String?
 consumos DescansoConsumo[]
 @@unique([vinculoId,dataAquisicao])
 @@index([prazoConcessivo])
}
model DescansoPeriodo {
 id String @id @default(uuid()) @db.Uuid
 vinculoId String @db.Uuid
 vinculo Vinculo @relation(fields:[vinculoId],references:[id])
 dataInicio DateTime @db.Date
 dataFim DateTime @db.Date
 quantidadeDias Decimal @db.Decimal(5,2)
 tipo String
 status String @default("PROGRAMADO")
 motivo String?
 observacoes String?
 consumos DescansoConsumo[]
 @@index([vinculoId,dataInicio,dataFim])
}
model DescansoAjuste {
 id String @id @default(uuid()) @db.Uuid
 vinculoId String @db.Uuid
 vinculo Vinculo @relation(fields:[vinculoId],references:[id])
 tipo String
 quantidadeDias Decimal @db.Decimal(5,2)
 dataReferencia DateTime? @db.Date
 motivo String
 criadoPor String @db.Uuid
 usuario Usuario @relation(fields:[criadoPor],references:[id])
 criadoEm DateTime @default(now())
 @@index([vinculoId])
}
model DescansoConsumo {
 id String @id @default(uuid()) @db.Uuid
 periodoId String @db.Uuid
 periodo DescansoPeriodo @relation(fields:[periodoId],references:[id])
 direitoId String? @db.Uuid
 direito DescansoDireito? @relation(fields:[direitoId],references:[id])
 quantidadeDias Decimal @db.Decimal(5,2)
 motivo String?
 criadoPor String @db.Uuid
 usuario Usuario @relation(fields:[criadoPor],references:[id])
 criadoEm DateTime @default(now())
 @@index([periodoId])
 @@index([direitoId])
}
model Fornecedor {
 id String @id @default(uuid()) @db.Uuid
 nome String @unique
 ativo Boolean @default(true)
 configuracoes ConfiguracaoBeneficio[]
}
model ConfiguracaoBeneficio {
 id String @id @default(uuid()) @db.Uuid
 unidadeId String @db.Uuid
 unidade Unidade @relation(fields:[unidadeId],references:[id])
 tipo String
 fornecedorId String @db.Uuid
 fornecedor Fornecedor @relation(fields:[fornecedorId],references:[id])
 ativa Boolean @default(true)
 observacoes String?
 competencias BeneficioCompetencia[]
 @@unique([unidadeId,tipo,fornecedorId])
}
model BeneficioVinculo {
 id String @id @default(uuid()) @db.Uuid
 vinculoId String @db.Uuid
 vinculo Vinculo @relation(fields:[vinculoId],references:[id])
 tipo String
 inicioVigencia DateTime @db.Date
 fimVigencia DateTime? @db.Date
 status String @default("ATIVO")
 observacoes String?
 competencias BeneficioCompetencia[]
 @@index([vinculoId,tipo])
}
model BeneficioCompetencia {
 id String @id @default(uuid()) @db.Uuid
 beneficioVinculoId String @db.Uuid
 beneficioVinculo BeneficioVinculo @relation(fields:[beneficioVinculoId],references:[id])
 configuracaoId String @db.Uuid
 configuracao ConfiguracaoBeneficio @relation(fields:[configuracaoId],references:[id])
 componente String @default("Principal")
 competencia DateTime @db.Date
 quantidadeDias Decimal? @db.Decimal(7,2)
 quantidade Decimal? @db.Decimal(7,2)
 valorUnitario Decimal? @db.Decimal(12,2)
 valorInformado Decimal? @db.Decimal(12,2)
 status String @default("PENDENTE")
 observacoes String?
 ajustes BeneficioAjuste[]
 @@unique([beneficioVinculoId,configuracaoId,competencia,componente])
 @@index([competencia,status])
}
model BeneficioAjuste {
 id String @id @default(uuid()) @db.Uuid
 competenciaId String @db.Uuid
 competencia BeneficioCompetencia @relation(fields:[competenciaId],references:[id])
 tipo String
 valor Decimal @db.Decimal(12,2)
 motivo String
 criadoPor String @db.Uuid
 usuario Usuario @relation(fields:[criadoPor],references:[id])
 criadoEm DateTime @default(now())
 @@index([competenciaId])
}
