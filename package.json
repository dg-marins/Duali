{
  "name": "duali",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @duali/database generate",
    "db:migrate": "pnpm --filter @duali/database migrate",
    "admin:create": "pnpm --filter @duali/api admin:create",
    "admin:reset": "pnpm --filter @duali/api admin:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.48.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.19.0",
    "@playwright/test": "^1.56.1"
  }
}
